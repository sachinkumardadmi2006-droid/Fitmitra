{
  "expo": {
    "name": "FitMitra",
    "slug": "fitmitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitmitra",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitmitra.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060913"
      },
      "package": "com.fitmitra.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}