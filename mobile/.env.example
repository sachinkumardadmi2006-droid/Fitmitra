# ==============================================================================
# FitMitra Mobile App — Environment Configuration
# ==============================================================================
# In Expo, environment variables prefixed with EXPO_PUBLIC_ are automatically
# exposed to the React Native JavaScript bundle.
#
# Copy this file to .env and fill in your Firebase and Google credentials:
# cp .env.example .env
# ==============================================================================

# Backend API Endpoint
# - For Android Emulator: http://10.0.2.2:5000/api/v1
# - For Physical Device on Wi-Fi: http://<YOUR_LOCAL_IP>:5000/api/v1 (e.g., http://192.168.1.10:5000/api/v1)
# - For Production: https://api.fitmitra.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration
# (Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client IDs (for Google Sign-In & Sign-Up)
# ------------------------------------------------------------------------------
# Web Client ID (REQUIRED by Firebase to verify the Google ID token):
# (Obtain from: Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration -> Web client ID,
#  OR Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android Client ID (for production / standalone APK com.fitmitra.app):
# (Obtain from: Google Cloud Console -> Credentials -> Create Credentials -> OAuth client ID -> Android
#  Package Name: com.fitmitra.app
#  SHA-1 fingerprint: from your keystore or EAS build)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Android Client ID for Expo Go testing (Optional - required ONLY if testing Google OAuth inside Expo Go):
# (Package Name: host.exp.exponent
#  SHA-1 fingerprint: 19:76:da:e2:71:07:7a:bf:a2:ac:7e:92:4a:d6:e4:6f:d1:74:24:99)
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-expogo-client-id.apps.googleusercontent.com

# iOS Client ID (optional, if testing on iOS devices):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
